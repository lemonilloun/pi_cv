# Copy this file to .env and set values for your network.

# MacBook IP address reachable from Raspberry Pi on the same Wi-Fi network.
PI_CV_SERVER_HOST=xxx.xxx.x.xxx

# Server bind host on MacBook. 0.0.0.0 means listen on all interfaces.
PI_CV_SERVER_BIND_HOST=0.0.0.0
PI_CV_SERVER_PORT=8765

PI_CV_DEVICE_ID=raspberry_pi_01
PI_CV_CONNECT_TIMEOUT_SECONDS=5
PI_CV_STORAGE_DIR=data/received
PI_CV_PREVIEW_ENABLED=true
PI_CV_PREVIEW_HOST=127.0.0.1
PI_CV_PREVIEW_PORT=8080
PI_CV_LOG_LEVEL=INFO

# Persistent session client (scripts/run_pi_session.sh) overrides.
# PI_CV_SESSION_SOURCE=camera
# PI_CV_SESSION_INITIAL_MODE=idle
# PI_CV_SESSION_STREAM_FPS=30
# PI_CV_SESSION_CV_FPS=1
# PI_CV_SESSION_YOLO_MODEL=models/yolo26n-seg_ncnn_model
# PI_CV_SESSION_YOLO_TASK=segment
# PI_CV_SESSION_DEPTH_BACKEND=depth-anything-v2
# PI_CV_SESSION_DEPTH_MODEL_PATH=models/depth_anything_v2_vits.pth
# PI_CV_SESSION_TORCH_THREADS=3
