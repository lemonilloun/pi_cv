{
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "backlog": 5,
    "storage_dir": "data/received"
  },
  "client": {
    "device_id": "raspberry_pi_01",
    "server_host": "127.0.0.1",
    "connect_timeout_seconds": 5
  },
  "preview": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8080
  },
  "session": {
    "source": "camera",
    "initial_mode": "idle",
    "telemetry_hz": 1.0,
    "camera_width": 1280,
    "camera_height": 720,
    "stream_fps": 30.0,
    "stream_quality": 85,
    "cv_fps": 1.0,
    "reconnect_min_seconds": 1.0,
    "reconnect_max_seconds": 30.0,
    "synthetic_image": "data/cat.jpg",
    "yolo_backend": "ncnn",
    "yolo_model": "models/yolo26n_ncnn_model",
    "yolo_task": "detect",
    "yolo_confidence": 0.5,
    "yolo_fps": 25.0,
    "hailo_hef": "/usr/share/hailo-models/yolov8s_h8l.hef",
    "hailo_arch": "yolov8",
    "hailo_labels": null,
    "depth_backend": "depth-anything-v2",
    "depth_model_path": "models/depth_anything_v2_vits.pth",
    "depth_encoder": "vits",
    "depth_input_size": 392,
    "depth_is_metric": false,
    "torch_threads": 3
  },
  "server_cv": {
    "enabled": true,
    "device": "mps",
    "depth_model_path": "models/depth_anything_v2_metric_hypersim_vits.pth",
    "depth_encoder": "vits",
    "depth_input_size": 392,
    "depth_max_depth_m": 20.0,
    "display_max_m": 8.0,
    "target_fps": 15.0,
    "hfov_deg": 102.0,
    "vfov_deg": 67.0
  },
  "mapping": {
    "rooms_dir": "data/rooms",
    "grid_resolution_m": 0.05,
    "height_band_m": [0.1, 2.0],
    "camera_height_m": 0.3,
    "hfov_deg": 102.0,
    "vfov_deg": 67.0,
    "point_stride": 4,
    "edge_crop_frac": 0.1,
    "min_hits": 3,
    "max_depth_use_m": 8.0,
    "wall_jump_reject_m": 0.5,
    "wall_ema_alpha": 0.4,
    "body_offset_m": 0.4,
    "max_room_m": 10.0,
    "min_wall_height_m": 1.6,
    "depth_scale_correction": 1.0
  },
  "scene3d": {
    "sessions_dir": "data/scene_sessions",
    "fallback_hfov_deg": 102.0,
    "depth": {
      "model_path": "models/depth_anything_v2_metric_hypersim_vits.pth",
      "encoder": "vits",
      "input_size": 518,
      "max_depth_m": 20.0,
      "device": "mps"
    },
    "poses": {
      "sequential_overlap": 10,
      "min_registered_frac": 0.5
    },
    "tsdf": {
      "voxel_m": 0.02,
      "sdf_trunc_m": 0.08,
      "depth_trunc_m": 5.0,
      "mask_edge_erode_px": 6,
      "plan_resolution_m": 0.03,
      "plan_height_band_m": [0.15, 1.9]
    },
    "objects": {
      "device": "mps",
      "dino_cos_min": 0.6,
      "centroid_max_m": 0.5,
      "min_observations": 3,
      "dbscan_eps_m": 0.05,
      "dbscan_min_points": 20,
      "point_stride": 4
    },
    "graph": {
      "clip_text_model": "RN50x4",
      "clip_text_pretrained": "openai",
      "near_max_m": 0.5,
      "on_gap_m": 0.08
    }
  },
  "monitoring": {
    "enabled": true,
    "data_dir": "data/monitoring",
    "min_confidence": 0.35,
    "anchor_classes": ["couch", "bed", "chair", "dining table", "tv"],
    "iou_gate": 0.1,
    "centroid_gate_frac": 0.15,
    "confirm_hits": 3,
    "lost_after_s": 2.0,
    "end_after_s": 10.0,
    "event_open_hold_s": 2.0,
    "event_close_hold_s": 3.0,
    "overlap_on_ratio": 0.3,
    "depth_agree_m": 0.7,
    "presence": {
      "exit_edge_frac": 0.10,
      "exit_absent_s": 25.0,
      "presence_timeout_s": 300.0
    },
    "relations": {
      "near_gap_frac": 0.05,
      "near_depth_agree_m": 1.0,
      "move_min_frac": 0.15
    },
    "embeddings": {
      "enabled": true,
      "model": "MobileCLIP-S1",
      "device": "mps"
    },
    "qa": {
      "key_moments_per_digest": 3,
      "key_snapshot_retention_h": 24
    },
    "snapshot_events": ["entered", "on"],
    "retention_days": 14,
    "max_snapshot_mb": 200,
    "agent": {
      "enabled": true,
      "auto_start": true,
      "base_url": "http://127.0.0.1:11500",
      "model": "apple-foundationmodel",
      "digest_interval_s": 300,
      "timeout_s": 20,
      "max_input_tokens": 2500,
      "max_output_tokens": 400
    },
    "vision": {
      "enabled": false,
      "auto_start": true,
      "base_url": "http://127.0.0.1:11434",
      "model": "gemma4:e4b-it-qat",
      "keep_alive": "0s",
      "timeout_s": 120,
      "crop_margin_frac": 0.15,
      "caption_events": ["on"]
    }
  },
  "logging": {
    "level": "INFO"
  }
}
